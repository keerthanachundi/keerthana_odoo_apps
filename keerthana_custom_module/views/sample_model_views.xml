<odoo>
    <record id="view_form_sample_model" model="ir.ui.view">
        <field name="name">keerthana.sample.form</field>
        <field name="model">keerthana.sample</field>
        <field name="arch" type="xml">
            <form string="Sample">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sample_model" model="ir.actions.act_window">
        <field name="name">Sample Model</field>
        <field name="res_model">keerthana.sample</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_sample_root" name="Sample"/>
    <menuitem id="menu_sample_model" name="Sample Model" parent="menu_sample_root" action="action_sample_model"/>
</odoo>
